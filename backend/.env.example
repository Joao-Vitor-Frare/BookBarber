# Supabase / PostgreSQL
# DATABASE_URL: Transaction Pooler (porta 6543) para o backend/serverless.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Session Pooler (porta 5432) ou conexão direta para Prisma CLI/migrations.
# O Session Pooler costuma ser a opção mais simples quando a rede local não possui IPv6.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@REGIAO.pooler.supabase.com:5432/postgres"

PORT=3000
JWT_SECRET="troque-esta-chave-em-producao"

# URL do frontend publicado. Para desenvolvimento local, pode deixar em branco.
# Para mais de uma origem, separe por vírgula.
FRONTEND_URL=""

ADMIN_NOME="Administrador"
ADMIN_TELEFONE="(00) 00000-0000"
ADMIN_EMAIL="admin@bookbarber.com"
ADMIN_PASSWORD="admin123"
